{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tumor-markers.schema.json",
  "title": "Tumor belirteci eslemesi",
  "type": "object",
  "required": ["schemaVersion", "default", "mappings"],
  "properties": {
    "schemaVersion": { "type": "number", "minimum": 1 },
    "note": { "type": "string" },
    "default": {
      "type": "object", "required": ["label"], "additionalProperties": false,
      "properties": { "markers": { "type": "array", "items": { "type": "string" } }, "label": { "type": "string" } }
    },
    "mappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["codes", "markers", "label"], "additionalProperties": false,
        "properties": {
          "codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "markers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "label": { "type": "string" }
        }
      }
    },
    "tracerOverrides": {
      "type": "array",
      "items": {
        "type": "object", "required": ["tracer", "label"], "additionalProperties": false,
        "properties": {
          "tracer": { "type": "string" },
          "markers": { "type": "array", "items": { "type": "string" } },
          "label": { "type": "string" }
        }
      }
    }
  }
}
