{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quick-picks.schema.json",
  "title": "ICD hizli secim kisayollari",
  "type": "object",
  "required": ["schemaVersion", "byTracer"],
  "properties": {
    "schemaVersion": { "type": "number", "minimum": 1 },
    "note": { "type": "string" },
    "byTracer": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "array",
          "items": {
            "type": "object", "required": ["code", "label"], "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][0-9][0-9A-Z](\\.[0-9A-Z]{1,4})?$" },
              "label": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
