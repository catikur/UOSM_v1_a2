{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sources.schema.json",
  "title": "Otomatik izleme kaynaklari",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "type": "number", "minimum": 1 },
    "note": { "type": "string" },
    "userAgent": { "type": "string" },
    "requestTimeoutMs": { "type": "number", "minimum": 1000 },
    "retries": { "type": "number", "minimum": 0 },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "url", "kind", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "type": "string", "enum": ["html", "json", "text"] },
          "watch": { "type": "string" },
          "affects": { "type": "array", "items": { "type": "string" } },
          "normalize": { "type": "array", "items": { "type": "string", "enum": ["strip-script", "strip-style", "collapse-whitespace", "strip-csrf", "strip-dates"] } },
          "enabled": { "type": "boolean" },
          "disabledReason": { "type": "string" }
        }
      }
    }
  }
}
