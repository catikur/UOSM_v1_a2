{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tracers.schema.json",
  "title": "Radyofarmasotikler",
  "type": "object",
  "required": ["schemaVersion", "tracers", "facilityLevels"],
  "properties": {
    "schemaVersion": { "type": "number", "minimum": 1 },
    "note": { "type": "string" },
    "tracers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "icon", "order", "covered", "askIcd", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "sutCode": { "type": "string", "nullable": true },
          "icon": { "type": "string" },
          "order": { "type": "number", "minimum": 0 },
          "covered": { "type": "boolean" },
          "codeSet": { "type": "string", "nullable": true },
          "entryNode": { "type": "string", "nullable": true },
          "askIcd": { "type": "boolean" },
          "icdPrompt": { "type": "string" },
          "summary": { "type": "string" },
          "notCoveredOutcome": {
            "type": "object",
            "required": ["status", "reason"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "string", "enum": ["covered", "not-covered"] },
              "indication": { "type": "string" },
              "reason": { "type": "string" },
              "sutRefs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "facilityLevels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "label": { "type": "string" },
          "shortLabel": { "type": "string" }, "icon": { "type": "string" }
        }
      }
    }
  }
}
