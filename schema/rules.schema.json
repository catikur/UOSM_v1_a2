{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rules.schema.json",
  "title": "Karar agaci",
  "type": "object",
  "required": [
    "schemaVersion",
    "entryNode",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "entryNode": {
      "type": "string"
    },
    "predicateOps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "question": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "parametric": {
            "type": "boolean"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionsFrom": {
            "type": "string",
            "enum": [
              "tracers"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "label": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "neutral",
                    "danger"
                  ]
                },
                "visibleWhen": {
                  "type": "object"
                },
                "setsFacility": {
                  "type": "string"
                },
                "next": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "node"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "node": {
                          "type": "string"
                        },
                        "params": {
                          "type": "object"
                        }
                      }
                    }
                  ]
                },
                "branch": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "when": {
                        "type": "object"
                      },
                      "next": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "node"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "node": {
                                "type": "string"
                              },
                              "params": {
                                "type": "object"
                              }
                            }
                          }
                        ]
                      },
                      "outcome": {
                        "type": "object"
                      }
                    }
                  }
                },
                "outcome": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "covered",
                        "not-covered"
                      ]
                    },
                    "indication": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "sutRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
